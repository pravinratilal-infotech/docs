# Copy to dev/.env:
#   cp dev/.env.example dev/.env
#
# Service account key (never commit):
#   dev/secrets/google-drive-service-account.json
#
# Share Drive folders with the service account email (Editor).
# GOOGLE_DRIVE_FOLDER_ID is optional — leave empty to list all shared folders.

GOOGLE_DRIVE_ENABLED=TRUE
GOOGLE_DRIVE_FOLDER_ID=
